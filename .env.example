# Puerto del servidor HTTP
PORT=3000

# Secreto para firmar los JWT (cámbialo en tu entorno)
JWT_SECRET=dev-secret-change-me

# Tiempo de expiración del token (formato de jsonwebtoken: 1h, 30m, 7d, ...)
JWT_EXPIRES_IN=1h

# Secreto para firmar los refresh tokens (distinto al de los access tokens)
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Expiración del refresh token
JWT_REFRESH_EXPIRES_IN=7d

# Ruta del archivo SQLite local (usa :memory: para una base en memoria)
DB_PATH=./data/app.db
